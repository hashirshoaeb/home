{
  "name": "jpromero-website",
  "description": "Personal website of Juan P. Romero, hosted with GitHub Pages.",
  "homepage": "https://jpromeror.github.io/website",
  "version": "2.0.0",
  "dependencies": {
    "bootstrap": "^5.2.0",
    "sass": "^1.54.3",
    "react-typist-component": "^1.0.3",
    "react": "^18.2.0",
    "react-bootstrap": "^2.5.0",
    "react-dom": "^18.2.0",
    "react-loading-skeleton": "^3.1.0",
    "react-router": "^6.3.0",
    "react-router-dom": "^6.3.0",
    "react-scripts": "5.0.1",
    "web-vitals": "^2.1.4"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^5.16.5",
    "@testing-library/react": "^13.3.0",
    "@testing-library/user-event": "^13.5.0",
    "gh-pages": "^4.0.0"
  },
  "scripts": {
    "fetch-publications": "node scripts/fetch-publications.mjs",
    "predeploy": "npm run fetch-publications && npm run build",
    "deploy": "gh-pages -d build",
    "start": "react-scripts start",
    "build": "react-scripts build",
    "test": "react-scripts test",
    "eject": "react-scripts eject"
  },
  "engines": {
    "npm": "^10.9.0",
    "node": "^22.12.0"
  },
  "eslintConfig": {
    "extends": [
      "react-app",
      "react-app/jest"
    ]
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  }
}